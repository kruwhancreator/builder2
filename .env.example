# ==============================================================================
# Sentence Builder 2 - Environment Variables Configuration
# ==============================================================================

# 1. Administrator Authentication
# Set a strong passcode for accessing /backend-admin
ADMIN_PASSCODE=your_admin_passcode_here
# Optional: Secret used for HMAC-SHA256 signing session cookies (defaults to ADMIN_PASSCODE if omitted)
ADMIN_SESSION_SECRET=your_admin_session_secret_min_32_chars

# 2. Supabase Configuration
# Required for database content and image storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Critical: Service role key is required on the server for secure mutations and atomic saves
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 3. Google Gemini AI Evaluation
# Required for live semantic evaluation of picture description exercises
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Default model is gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
